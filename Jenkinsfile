pipeline { agent any; stages { stage('Syntax') { steps { dir('flask-v2.0.1') { sh 'python3 -m compileall -q app.py tests' } } } stage('Build') { steps { dir('flask-v2.0.1') { sh 'docker build --target test -t aceest-v2.0.1:test .'; sh 'docker build --target runtime -t aceest-v2.0.1:runtime .' } } } stage('Test') { steps { sh 'docker run --rm aceest-v2.0.1:test' } } } }
